# OPENAI_API_KEY: Required for Gemini AI API calls.
OPENAI_API_KEY="sk-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# --- SUPABASE CONFIGURATION ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- AI AGENT CONFIGURATION (BYOK) ---
# Partner keys will be encrypted and stored in Supabase, 
# but these are required for the main protocol operations.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."

# Server-only encryption key for BYOK & KMS (HARUS 32+ karakter)
ENCRYPTION_KEY="your_32_char_master_key_here_!!"
CRON_SECRET="your_cron_secret_here"

# --- BLOCKCHAIN / SOLANA ---
NEXT_PUBLIC_PROTOCOL_TREASURY_ADDRESS="DEWA6k7...v7P9"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# --- bags.fm SDK CONFIGURATION ---
BAGS_API_KEY="bags_prod_..."
# This is the "Partner Key" or "Partner Config PDA" from dev.bags.fm
NEXT_PUBLIC_BAGS_PARTNER_CONFIG="your_partner_config_pda_here"

# --- AI AGENT BACKEND (PYTHON) ---
AGENT_BACKEND_URL="http://localhost:8000"

# --- TWITTER / X API ---
TWITTER_API_KEY="your_api_key_here"
TWITTER_API_SECRET="your_api_secret_here"
TWITTER_ACCESS_TOKEN="your_access_token_here"
TWITTER_ACCESS_SECRET="your_access_token_secret_here"
TWITTER_BEARER_TOKEN="your_bearer_token_here"
TWITTER_DRY_RUN="true"

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- DATABASE ---
DATABASE_URL="postgresql://user:password@localhost:5432/dewa_db?schema=public"

# --- AUTHENTICATION ---
JWT_SECRET="your_jwt_secret_here"

